// Diagrama entidad-relación (notación pata de gallo) del modelo vigente.
// Fuente: backend/app/db/models.py (UserORM, SessionORM, SessionMetricORM,
// VideoDownloadJobORM), contrastado con backend/alembic/versions/.
// Las tablas feature_samples, training_jobs e ingest_jobs, que siguen creándose en las
// migraciones 20260404_0001 y 20260404_0002, ya no tienen modelo ORM tras retirar el
// módulo de aprendizaje continuo y no se representan.
digraph er {
  charset="utf-8";
  graph [rankdir=TB, fontname="Helvetica", fontsize=13, bgcolor="white", nodesep=0.8, ranksep=0.9, pad=0.3];
  node [shape=plain, fontname="Helvetica", fontsize=12];
  edge [fontname="Helvetica", fontsize=11, color="#333333", dir=both, arrowsize=1.1];

  users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#333333">
    <TR><TD COLSPAN="4" BGCOLOR="#E8F1FB"><B>users</B></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT">UUID</TD><TD ALIGN="LEFT">NOT NULL</TD></TR>
    <TR><TD ALIGN="LEFT">UQ</TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">TEXT</TD><TD ALIGN="LEFT">NOT NULL</TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD><TD ALIGN="LEFT">NOT NULL · DEFAULT now()</TD></TR>
  </TABLE>>];

  sessions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#333333">
    <TR><TD COLSPAN="4" BGCOLOR="#EAF6EC"><B>sessions</B></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT">UUID</TD><TD ALIGN="LEFT">NOT NULL</TD></TR>
    <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">user_id → users.id</TD><TD ALIGN="LEFT">UUID</TD><TD ALIGN="LEFT">NOT NULL · ON DELETE CASCADE</TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">exercise_label</TD><TD ALIGN="LEFT">VARCHAR(128)</TD><TD ALIGN="LEFT">NOT NULL</TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">started_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD><TD ALIGN="LEFT">NOT NULL · DEFAULT now()</TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">ended_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD><TD ALIGN="LEFT">NULL</TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">device_info</TD><TD ALIGN="LEFT">JSONB</TD><TD ALIGN="LEFT">NULL</TD></TR>
  </TABLE>>];

  session_metrics [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#333333">
    <TR><TD COLSPAN="4" BGCOLOR="#FFF6E0"><B>session_metrics</B></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT">UUID</TD><TD ALIGN="LEFT">NOT NULL</TD></TR>
    <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">session_id → sessions.id</TD><TD ALIGN="LEFT">UUID</TD><TD ALIGN="LEFT">NOT NULL · ON DELETE CASCADE</TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">frame_index</TD><TD ALIGN="LEFT">INTEGER</TD><TD ALIGN="LEFT">NULL</TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">rep_count</TD><TD ALIGN="LEFT">INTEGER</TD><TD ALIGN="LEFT">NULL</TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">avg_confidence</TD><TD ALIGN="LEFT">FLOAT</TD><TD ALIGN="LEFT">NULL</TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">quality_score</TD><TD ALIGN="LEFT">FLOAT</TD><TD ALIGN="LEFT">NULL</TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">flags_json</TD><TD ALIGN="LEFT">JSONB</TD><TD ALIGN="LEFT">NULL</TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD><TD ALIGN="LEFT">NOT NULL · DEFAULT now()</TD></TR>
  </TABLE>>];

  video_download_jobs [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#333333">
    <TR><TD COLSPAN="4" BGCOLOR="#F3ECF8"><B>video_download_jobs</B></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT">UUID</TD><TD ALIGN="LEFT">NOT NULL</TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">celery_task_id</TD><TD ALIGN="LEFT">VARCHAR(255)</TD><TD ALIGN="LEFT">NULL</TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">url</TD><TD ALIGN="LEFT">TEXT</TD><TD ALIGN="LEFT">NOT NULL</TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD ALIGN="LEFT">NOT NULL · 'pending'</TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">file_path</TD><TD ALIGN="LEFT">TEXT</TD><TD ALIGN="LEFT">NULL</TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">error_message</TD><TD ALIGN="LEFT">TEXT</TD><TD ALIGN="LEFT">NULL</TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD><TD ALIGN="LEFT">NOT NULL · DEFAULT now()</TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD><TD ALIGN="LEFT">NOT NULL · DEFAULT now() · ON UPDATE</TD></TR>
  </TABLE>>];

  nota [shape=note, style=filled, fillcolor="#FFFBE6", color="#999999", fontsize=11, margin="0.15,0.1",
        label=<video_download_jobs no tiene claves foráneas:<BR ALIGN="LEFT"/>registra los trabajos Celery de descarga por URL.<BR ALIGN="LEFT"/>Todas las tablas son opcionales (DATABASE_URL).<BR ALIGN="LEFT"/>>];

  // Pata de gallo: el extremo de "muchos" lleva crow; el de "uno", tee.
  users -> sessions [arrowtail=teetee, arrowhead=crowodot, label=<  tiene  >];
  sessions -> session_metrics [arrowtail=teetee, arrowhead=crowodot, label=<  registra  >];
  nota -> video_download_jobs [dir=none, style=dashed, color="#888888"];
  { rank=same; users; video_download_jobs; }
  { rank=same; sessions; nota; }
}
