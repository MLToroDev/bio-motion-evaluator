// Diagrama de clases — esquemas de datos (Pydantic) y persistencia (ORM)
// Generado por generar_clases.py — no editar a mano.
digraph "clases_esquemas_persistencia" {
  charset="utf-8";
  graph [rankdir=TB, fontname="Helvetica", fontsize=12, bgcolor="white", nodesep=0.35, ranksep=0.55, pad=0.3, newrank=true];
  node [shape=plain, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10, color="#333333", arrowsize=0.9];
  subgraph "cluster_ws" {
    label=<<B>Contratos WebSocket y REST — app.models.schemas</B>>; labeljust="l"; style="rounded,filled"; fillcolor="#FFFDF5"; color="#9A9A9A"; fontsize=12; margin=12;
    "PoseStreamConfig" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" CELLPADDING="4"><FONT POINT-SIZE="10">«pydantic»</FONT><BR/><B><FONT POINT-SIZE="13">PoseStreamConfig</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">app.models.schemas</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ source: "camera" | "file" | "url" = "file"<BR ALIGN="LEFT"/>+ video_filename: str | None<BR ALIGN="LEFT"/>+ device_index: int = 0<BR ALIGN="LEFT"/>+ stream_url: str | None<BR ALIGN="LEFT"/>+ target_fps: float = 15.0  [0.5, 60]<BR ALIGN="LEFT"/>+ max_throughput: bool = False<BR ALIGN="LEFT"/>+ stream_tuning: "auto" | "off" = "auto"<BR ALIGN="LEFT"/>+ include_preview: bool = True<BR ALIGN="LEFT"/>+ preview_fps: 8 | 10 | 12 = 10<BR ALIGN="LEFT"/>+ preview_jpeg_quality: int = 84  [70, 90]<BR ALIGN="LEFT"/>+ capture_only: bool = False<BR ALIGN="LEFT"/>+ forced_exercise_label: str | None<BR ALIGN="LEFT"/>+ diagnostics: bool = False<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR></TABLE>>];
    "UnifiedWsFrameV1" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" CELLPADDING="4"><FONT POINT-SIZE="10">«pydantic»</FONT><BR/><B><FONT POINT-SIZE="13">UnifiedWsFrameV1</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">app.models.schemas</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ schema_version: int = 1<BR ALIGN="LEFT"/>+ frame_index: int<BR ALIGN="LEFT"/>+ server_ts_ms: int<BR ALIGN="LEFT"/>+ pose_ok: bool<BR ALIGN="LEFT"/>+ note: str | None<BR ALIGN="LEFT"/>+ landmarks: list[dict] | None<BR ALIGN="LEFT"/>+ knees: dict[str, Any] | None<BR ALIGN="LEFT"/>+ exercise_label: str = "unknown"<BR ALIGN="LEFT"/>+ exercise_confidence: float  [0, 1]<BR ALIGN="LEFT"/>+ rep_phase: str = "idle"<BR ALIGN="LEFT"/>+ rep_count: int<BR ALIGN="LEFT"/>+ quality_flags: list[str]<BR ALIGN="LEFT"/>+ pipeline_ms: dict[str, float] | None<BR ALIGN="LEFT"/>+ preview_jpeg_base64: str | None<BR ALIGN="LEFT"/>+ total_frames: int | None<BR ALIGN="LEFT"/>+ error: str | None<BR ALIGN="LEFT"/>+ stream_done: bool | None<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR></TABLE>>];
    "PipelineTimingMs" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" CELLPADDING="4"><FONT POINT-SIZE="10">«pydantic»</FONT><BR/><B><FONT POINT-SIZE="13">PipelineTimingMs</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">app.models.schemas</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ extract, feature, classify: float<BR ALIGN="LEFT"/>+ track, total: float<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR></TABLE>>];
    "PoseAnalysisResponse" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" CELLPADDING="4"><FONT POINT-SIZE="10">«pydantic»</FONT><BR/><B><FONT POINT-SIZE="13">PoseAnalysisResponse</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">app.models.schemas</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ ok: bool<BR ALIGN="LEFT"/>+ landmarks: list[LandmarkPoint]<BR ALIGN="LEFT"/>+ world_landmarks: list[LandmarkPoint]<BR ALIGN="LEFT"/>+ note: str | None<BR ALIGN="LEFT"/>+ raw: dict[str, Any] | None<BR ALIGN="LEFT"/>+ exercise_label, rep_phase: str<BR ALIGN="LEFT"/>+ exercise_confidence: float<BR ALIGN="LEFT"/>+ rep_count: int<BR ALIGN="LEFT"/>+ quality_flags: list[str]<BR ALIGN="LEFT"/>+ pipeline_ms: dict[str, float] | None<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR></TABLE>>];
    "LandmarkPoint" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" CELLPADDING="4"><FONT POINT-SIZE="10">«pydantic»</FONT><BR/><B><FONT POINT-SIZE="13">LandmarkPoint</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">app.models.schemas</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ index: int<BR ALIGN="LEFT"/>+ x: float<BR ALIGN="LEFT"/>+ y: float<BR ALIGN="LEFT"/>+ z: float<BR ALIGN="LEFT"/>+ visibility: float | None<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR></TABLE>>];
    "HealthResponse" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" CELLPADDING="4"><FONT POINT-SIZE="10">«pydantic»</FONT><BR/><B><FONT POINT-SIZE="13">HealthResponse</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">app.models.schemas</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ status: str = "ok"<BR ALIGN="LEFT"/>+ version: str<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR></TABLE>>];
    "ExerciseClassifierConfig" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><FONT POINT-SIZE="10">«pydantic»</FONT><BR/><B><FONT POINT-SIZE="13">ExerciseClassifierConfig</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">app.models.schemas · detalle en (a-2)</FONT></TD></TR></TABLE>>];
    "nota_pydantic" [shape=note, style=filled, fillcolor="#FFFBE6", color="#999999", fontsize=10, margin="0.12,0.08", label=<Toda clase «pydantic» hereda de pydantic.BaseModel.<BR ALIGN="LEFT"/>PoseStreamConfig es el primer mensaje (texto JSON)<BR ALIGN="LEFT"/>del cliente en /ws/pose-stream.<BR ALIGN="LEFT"/>>];
    "nota_unified" [shape=note, style=filled, fillcolor="#FFFBE6", color="#999999", fontsize=10, margin="0.12,0.08", label=<UnifiedWsFrameV1 documenta y valida (pruebas) el contrato<BR ALIGN="LEFT"/>servidor → cliente; en ejecución se envía el dict de<BR ALIGN="LEFT"/>build_frame_payload_v1() más total_frames, preview, etc.<BR ALIGN="LEFT"/>knees usa la convención flexión = 180° − interno;<BR ALIGN="LEFT"/>PipelineTimingMs documenta el campo pipeline_ms.<BR ALIGN="LEFT"/>>];
  }
  subgraph "cluster_dto" {
    label=<<B>Cuerpos y respuestas definidos en los routers — app.api.v1</B>>; labeljust="l"; style="rounded,filled"; fillcolor="#FFFDF5"; color="#9A9A9A"; fontsize=12; margin=12;
    "StubLogin" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" CELLPADDING="4"><FONT POINT-SIZE="10">«pydantic»</FONT><BR/><B><FONT POINT-SIZE="13">StubLogin</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">app.api.v1.auth</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ email: str<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR></TABLE>>];
    "TokenResponse" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" CELLPADDING="4"><FONT POINT-SIZE="10">«pydantic»</FONT><BR/><B><FONT POINT-SIZE="13">TokenResponse</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">app.api.v1.auth</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ access_token: str<BR ALIGN="LEFT"/>+ token_type: str = "bearer"<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR></TABLE>>];
    "CreateSessionBody" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" CELLPADDING="4"><FONT POINT-SIZE="10">«pydantic»</FONT><BR/><B><FONT POINT-SIZE="13">CreateSessionBody</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">app.api.v1.sessions</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ exercise_label: str = "unknown"<BR ALIGN="LEFT"/>+ device_info: dict[str, Any] | None<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR></TABLE>>];
    "SessionOut" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" CELLPADDING="4"><FONT POINT-SIZE="10">«pydantic»</FONT><BR/><B><FONT POINT-SIZE="13">SessionOut</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">app.api.v1.sessions (from_attributes)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ id: UUID<BR ALIGN="LEFT"/>+ user_id: UUID<BR ALIGN="LEFT"/>+ exercise_label: str<BR ALIGN="LEFT"/>+ started_at: datetime | None<BR ALIGN="LEFT"/>+ ended_at: datetime | None<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR></TABLE>>];
    "SessionMetricBody" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" CELLPADDING="4"><FONT POINT-SIZE="10">«pydantic»</FONT><BR/><B><FONT POINT-SIZE="13">SessionMetricBody</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">app.api.v1.sessions</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ frame_index: int | None<BR ALIGN="LEFT"/>+ rep_count: int | None<BR ALIGN="LEFT"/>+ avg_confidence: float | None<BR ALIGN="LEFT"/>+ quality_score: float | None<BR ALIGN="LEFT"/>+ flags_json: dict[str, Any] | None<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR></TABLE>>];
    "DownloadRequest" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" CELLPADDING="4"><FONT POINT-SIZE="10">«pydantic»</FONT><BR/><B><FONT POINT-SIZE="13">DownloadRequest</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">app.api.v1.download</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ url: HttpUrl<BR ALIGN="LEFT"/>+ quality: DownloadQuality = "best"<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR></TABLE>>];
    "DownloadResponse" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" CELLPADDING="4"><FONT POINT-SIZE="10">«pydantic»</FONT><BR/><B><FONT POINT-SIZE="13">DownloadResponse</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">app.api.v1.download</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ job_id: UUID<BR ALIGN="LEFT"/>+ status: str<BR ALIGN="LEFT"/>+ message: str<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR></TABLE>>];
    "StatusResponse" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" CELLPADDING="4"><FONT POINT-SIZE="10">«pydantic»</FONT><BR/><B><FONT POINT-SIZE="13">StatusResponse</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">app.api.v1.download</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ job_id: UUID<BR ALIGN="LEFT"/>+ status: str<BR ALIGN="LEFT"/>+ file_path: str | None<BR ALIGN="LEFT"/>+ error_message: str | None<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR></TABLE>>];
  }
  subgraph "cluster_orm" {
    label=<<B>Modelos ORM (SQLAlchemy 2) — app.db</B>>; labeljust="l"; style="rounded,filled"; fillcolor="#F6FBF7"; color="#9A9A9A"; fontsize=12; margin=12;
    "Base" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#EAF6EC" CELLPADDING="4"><FONT POINT-SIZE="10">«DeclarativeBase»</FONT><BR/><B><FONT POINT-SIZE="13">Base</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">app.db.base</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR></TABLE>>];
    "UserORM" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#EAF6EC" CELLPADDING="4"><FONT POINT-SIZE="10">«ORM · users»</FONT><BR/><B><FONT POINT-SIZE="13">UserORM</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">app.db.models</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ id: UUID  {PK}<BR ALIGN="LEFT"/>+ email: str  {unique}<BR ALIGN="LEFT"/>+ created_at: datetime<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR></TABLE>>];
    "SessionORM" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#EAF6EC" CELLPADDING="4"><FONT POINT-SIZE="10">«ORM · sessions»</FONT><BR/><B><FONT POINT-SIZE="13">SessionORM</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">app.db.models</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ id: UUID  {PK}<BR ALIGN="LEFT"/>+ user_id: UUID  {FK users.id, CASCADE}<BR ALIGN="LEFT"/>+ exercise_label: str<BR ALIGN="LEFT"/>+ started_at: datetime<BR ALIGN="LEFT"/>+ ended_at: datetime | None<BR ALIGN="LEFT"/>+ device_info: JSONB | None<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR></TABLE>>];
    "SessionMetricORM" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#EAF6EC" CELLPADDING="4"><FONT POINT-SIZE="10">«ORM · session_metrics»</FONT><BR/><B><FONT POINT-SIZE="13">SessionMetricORM</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">app.db.models</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ id: UUID  {PK}<BR ALIGN="LEFT"/>+ session_id: UUID  {FK sessions.id, CASCADE}<BR ALIGN="LEFT"/>+ frame_index: int | None<BR ALIGN="LEFT"/>+ rep_count: int | None<BR ALIGN="LEFT"/>+ avg_confidence: float | None<BR ALIGN="LEFT"/>+ quality_score: float | None<BR ALIGN="LEFT"/>+ flags_json: JSONB | None<BR ALIGN="LEFT"/>+ created_at: datetime<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR></TABLE>>];
    "VideoDownloadJobORM" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#EAF6EC" CELLPADDING="4"><FONT POINT-SIZE="10">«ORM · video_download_jobs»</FONT><BR/><B><FONT POINT-SIZE="13">VideoDownloadJobORM</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">app.db.models</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ id: UUID  {PK}<BR ALIGN="LEFT"/>+ celery_task_id: str | None<BR ALIGN="LEFT"/>+ url: str<BR ALIGN="LEFT"/>+ status: str = "pending"<BR ALIGN="LEFT"/>+ file_path: str | None<BR ALIGN="LEFT"/>+ error_message: str | None<BR ALIGN="LEFT"/>+ created_at, updated_at: datetime<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR></TABLE>>];
    "nota_orm" [shape=note, style=filled, fillcolor="#FFFBE6", color="#999999", fontsize=10, margin="0.12,0.08", label=<PostgreSQL opcional (DATABASE_URL). Las rutas de sesión,<BR ALIGN="LEFT"/>autenticación y descarga lo requieren; el análisis de<BR ALIGN="LEFT"/>pose en vivo y por video no persiste datos.<BR ALIGN="LEFT"/>>];
  }
  "PoseAnalysisResponse" -> "LandmarkPoint" [dir=both, arrowtail=diamond, arrowhead=none, style=solid, label=<landmarks,<BR/>world_landmarks>, taillabel="1", headlabel="0..*", labeldistance=1.6, labelangle=35];
  "UserORM" -> "Base" [arrowhead=empty, style=solid];
  "SessionORM" -> "Base" [arrowhead=empty, style=solid];
  "SessionMetricORM" -> "Base" [arrowhead=empty, style=solid];
  "VideoDownloadJobORM" -> "Base" [arrowhead=empty, style=solid];
  "UserORM" -> "SessionORM" [arrowhead=vee, style=solid, label=<sessions / user>, taillabel="1", headlabel="0..*", labeldistance=1.6, labelangle=35, arrowhead=none];
  "SessionORM" -> "SessionMetricORM" [dir=both, arrowtail=diamond, arrowhead=none, style=solid, label=<metrics (delete-orphan)>, taillabel="1", headlabel="0..*", labeldistance=1.6, labelangle=35];
  "SessionOut" -> "SessionORM" [arrowhead=vee, style=dashed, label=<«from_attributes»>];
  "CreateSessionBody" -> "SessionORM" [arrowhead=vee, style=dashed, label=<«create»>];
  "SessionMetricBody" -> "SessionMetricORM" [arrowhead=vee, style=dashed, label=<«create»>];
  "StubLogin" -> "UserORM" [arrowhead=vee, style=dashed, label=<«create» si no existe>];
  "DownloadRequest" -> "VideoDownloadJobORM" [arrowhead=vee, style=dashed, label=<«create»>];
  "StatusResponse" -> "VideoDownloadJobORM" [arrowhead=vee, style=dashed, label=<«read»>];
  "nota_pydantic" -> "PoseStreamConfig" [arrowhead=none, style=dashed, color="#888888"];
  "nota_unified" -> "UnifiedWsFrameV1" [arrowhead=none, style=dashed, color="#888888"];
  "nota_orm" -> "Base" [arrowhead=none, style=dashed, color="#888888"];
  "LandmarkPoint" -> "TokenResponse" [style=invis];
  "UnifiedWsFrameV1" -> "UserORM" [style=invis];
  "HealthResponse" -> "DownloadResponse" [style=invis];
}
