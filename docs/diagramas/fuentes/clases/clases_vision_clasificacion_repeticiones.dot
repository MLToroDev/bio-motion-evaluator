// Diagrama de clases — núcleo de visión: características, clasificación y repeticiones
// Generado por generar_clases.py — no editar a mano.
digraph "clases_vision_clasificacion_repeticiones" {
  charset="utf-8";
  graph [rankdir=TB, fontname="Helvetica", fontsize=12, bgcolor="white", nodesep=0.35, ranksep=0.55, pad=0.3, newrank=true];
  node [shape=plain, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10, color="#333333", arrowsize=0.9];
  subgraph "cluster_feat" {
    label=<<B>Ventana de características</B>>; labeljust="l"; style="rounded,filled"; fillcolor="#F7FAFE"; color="#9A9A9A"; fontsize=12; margin=12;
    "nota_vector" [shape=note, style=filled, fillcolor="#FFFBE6", color="#999999", fontsize=10, margin="0.12,0.08", label=<build_feature_vector(): vector float32 de<BR ALIGN="LEFT"/>FEATURE_VECTOR_DIM = 32 componentes (medias, ROM,<BR ALIGN="LEFT"/>asimetría y periodicidad de la flexión de rodilla en la<BR ALIGN="LEFT"/>ventana; relleno con ceros al final).<BR ALIGN="LEFT"/>>];
    "FeatureEngine" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#E8F1FB" CELLPADDING="4"><B><FONT POINT-SIZE="13">FeatureEngine</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">vision.feature_engine</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- _window: deque[PoseFrame]<BR ALIGN="LEFT"/>- _calib_ref: float | None<BR ALIGN="LEFT"/>- _last_angular_vel: dict[str, float]<BR ALIGN="LEFT"/><U>FEATURE_VECTOR_DIM = 32</U><BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ push(pose, dt_s): None<BR ALIGN="LEFT"/>+ build_feature_vector(): np.ndarray<BR ALIGN="LEFT"/>+ build_feature_frame(pose, frame_index, exercise_label,<BR ALIGN="LEFT"/>      exercise_confidence, dt_s): FeatureFrame<BR ALIGN="LEFT"/>+ window_full(): bool<BR ALIGN="LEFT"/>+ reset(): None<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "FeatureFrame" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" CELLPADDING="4"><FONT POINT-SIZE="10">«dataclass»</FONT><BR/><B><FONT POINT-SIZE="13">FeatureFrame</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">vision.types</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ pose: PoseFrame<BR ALIGN="LEFT"/>+ frame_index: int<BR ALIGN="LEFT"/>+ exercise_label: str<BR ALIGN="LEFT"/>+ exercise_confidence: float<BR ALIGN="LEFT"/>+ dt_s: float<BR ALIGN="LEFT"/>+ angular_velocity_deg_s: dict[str, float]<BR ALIGN="LEFT"/>+ periodicity_score: float<BR ALIGN="LEFT"/>+ calibration_scale: float<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR></TABLE>>];
    "PoseFrame" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><FONT POINT-SIZE="10">«dataclass»</FONT><BR/><B><FONT POINT-SIZE="13">PoseFrame</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">vision.types · detalle en (a-1)</FONT></TD></TR></TABLE>>];
  }
  subgraph "cluster_clasif" {
    label=<<B>Clasificación de ejercicio</B>>; labeljust="l"; style="rounded,filled"; fillcolor="#F6FBF7"; color="#9A9A9A"; fontsize=12; margin=12;
    "nota_build" [shape=note, style=filled, fillcolor="#FFFBE6", color="#999999", fontsize=10, margin="0.12,0.08", label=<build_classifier(): HeuristicExerciseClassifier por defecto;<BR ALIGN="LEFT"/>_OnnxCls si hay manifest activo y modelo ONNX válido;<BR ALIGN="LEFT"/>NopExerciseClassifier con el flag use_nop_classifier.<BR ALIGN="LEFT"/>El resultado siempre se envuelve en HysteresisClassifier.<BR ALIGN="LEFT"/>>];
    "exercise_classifier" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#EAF6EC" CELLPADDING="4"><FONT POINT-SIZE="10">«utility»</FONT><BR/><B><FONT POINT-SIZE="13">exercise_classifier</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">vision.exercise_classifier</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ build_classifier(cfg, registry): HysteresisClassifier<BR ALIGN="LEFT"/>- _try_onnx_classifier(manifest, cfg): ExerciseClassifier | None<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "ModelRegistry" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#EAF6EC" CELLPADDING="4"><FONT POINT-SIZE="10">«dataclass»</FONT><BR/><B><FONT POINT-SIZE="13">ModelRegistry</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">vision.model_registry</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ backend_root: Path<BR ALIGN="LEFT"/>+ manifest_path: Path | None<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ load_active_manifest(): ExerciseModelManifest | None<BR ALIGN="LEFT"/>+ list_versions(): list[str]<BR ALIGN="LEFT"/>+ switch_version(name): None<BR ALIGN="LEFT"/>+ active_key(): str | None<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "ExerciseModelManifest" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#EAF6EC" CELLPADDING="4"><FONT POINT-SIZE="10">«dataclass (frozen)»</FONT><BR/><B><FONT POINT-SIZE="13">ExerciseModelManifest</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">vision.model_registry</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ name: str<BR ALIGN="LEFT"/>+ path: Path<BR ALIGN="LEFT"/>+ classes: tuple[str, ...]<BR ALIGN="LEFT"/>+ window_size: int | None<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR></TABLE>>];
    "nota_histeresis" [shape=note, style=filled, fillcolor="#FFFBE6", color="#999999", fontsize=10, margin="0.12,0.08", label=<Cambia de etiqueta solo si la confianza filtrada<BR ALIGN="LEFT"/>(EMA o Kalman) ≥ min_confidence durante<BR ALIGN="LEFT"/>hysteresis_frames fotogramas consecutivos;<BR ALIGN="LEFT"/>con ventana incompleta devuelve unknown_label.<BR ALIGN="LEFT"/>>];
    "HysteresisClassifier" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#EAF6EC" CELLPADDING="4"><B><FONT POINT-SIZE="13">HysteresisClassifier</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">vision.exercise_classifier</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- _inner: ExerciseClassifier<BR ALIGN="LEFT"/>- _stable_label: str<BR ALIGN="LEFT"/>- _candidate: str | None<BR ALIGN="LEFT"/>- _candidate_frames: int<BR ALIGN="LEFT"/>- _ema_confidence: float<BR ALIGN="LEFT"/>- _kalman: ScalarKalman1D<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ classify(features, window_full): ClassificationResult<BR ALIGN="LEFT"/>+ reset(): None<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "ScalarKalman1D" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#EAF6EC" CELLPADDING="4"><B><FONT POINT-SIZE="13">ScalarKalman1D</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">vision.scalar_kalman</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- _q: float<BR ALIGN="LEFT"/>- _r: float<BR ALIGN="LEFT"/>- _x: float | None<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ update(measurement): float<BR ALIGN="LEFT"/>+ reset(): None<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "ExerciseClassifier" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#EAF6EC" CELLPADDING="4"><FONT POINT-SIZE="10">«Protocol»</FONT><BR/><B><FONT POINT-SIZE="13"><I>ExerciseClassifier</I></FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">vision.exercise_classifier</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ classify(features, window_full): ClassificationResult<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "HeuristicExerciseClassifier" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#EAF6EC" CELLPADDING="4"><B><FONT POINT-SIZE="13">HeuristicExerciseClassifier</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">vision.heuristic_exercise_classifier</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- _classes: tuple[str, ...] = ("idle", "squat", "lunge")<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ classify(features, window_full): ClassificationResult<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "NopExerciseClassifier" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#EAF6EC" CELLPADDING="4"><B><FONT POINT-SIZE="13">NopExerciseClassifier</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">vision.exercise_classifier</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ classify(features, window_full): ClassificationResult<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "_OnnxCls" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#EAF6EC" CELLPADDING="4"><FONT POINT-SIZE="10">«local»</FONT><BR/><B><FONT POINT-SIZE="13">_OnnxCls</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">definida en _try_onnx_classifier()</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- _session: ort.InferenceSession<BR ALIGN="LEFT"/>- _classes: list[str]<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ classify(features, window_full): ClassificationResult<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "ClassificationResult" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" CELLPADDING="4"><FONT POINT-SIZE="10">«dataclass»</FONT><BR/><B><FONT POINT-SIZE="13">ClassificationResult</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">vision.types</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ label: str<BR ALIGN="LEFT"/>+ confidence: float<BR ALIGN="LEFT"/>+ raw_scores: dict[str, float] | None<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR></TABLE>>];
    "ExerciseClassifierConfig" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#EEEEEE" CELLPADDING="4"><FONT POINT-SIZE="10">«pydantic»</FONT><BR/><B><FONT POINT-SIZE="13">ExerciseClassifierConfig</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">app.models.schemas</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ min_confidence: float = 0.72<BR ALIGN="LEFT"/>+ window_size_frames: int = 45<BR ALIGN="LEFT"/>+ hysteresis_frames: int = 10<BR ALIGN="LEFT"/>+ unknown_label: str = "unknown"<BR ALIGN="LEFT"/>+ confidence_filter: "ema" | "kalman"<BR ALIGN="LEFT"/>+ confidence_ema_alpha: float = 0.25<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR></TABLE>>];
  }
  subgraph "cluster_track" {
    label=<<B>Seguimiento de repeticiones</B>>; labeljust="l"; style="rounded,filled"; fillcolor="#FAF7FC"; color="#9A9A9A"; fontsize=12; margin=12;
    "nota_router" [shape=note, style=filled, fillcolor="#FFFBE6", color="#999999", fontsize=10, margin="0.12,0.08", label=<_trackers: claves unknown, idle, squat, lunge<BR ALIGN="LEFT"/>(squat → SquatRepTracker; resto → UnknownRepTracker).<BR ALIGN="LEFT"/>Al cambiar de etiqueta se reinicia el tracker anterior.<BR ALIGN="LEFT"/>>];
    "RepTrackerRouter" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#F3ECF8" CELLPADDING="4"><B><FONT POINT-SIZE="13">RepTrackerRouter</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">vision.rep_tracker</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- _unknown_label: str<BR ALIGN="LEFT"/>- _last_effective: str | None<BR ALIGN="LEFT"/>- _trackers: dict[str, RepTracker]<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ update(frame: FeatureFrame): RepState<BR ALIGN="LEFT"/>+ reset_all(): None<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "RepTracker" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#F3ECF8" CELLPADDING="4"><FONT POINT-SIZE="10">«abstract»</FONT><BR/><B><FONT POINT-SIZE="13"><I>RepTracker</I></FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">vision.rep_tracker_abc (ABC)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><I>+ update(frame: FeatureFrame): RepState</I><BR ALIGN="LEFT"/><I>+ reset(): None</I><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "SquatRepTracker" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#F3ECF8" CELLPADDING="4"><B><FONT POINT-SIZE="13">SquatRepTracker</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">vision.rep_trackers.squat</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- _phase: Phase<BR ALIGN="LEFT"/>- _rep_count: int<BR ALIGN="LEFT"/>- _flex_peak: float<BR ALIGN="LEFT"/>- _flags: list[str]<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ update(frame: FeatureFrame): RepState<BR ALIGN="LEFT"/>+ reset(): None<BR ALIGN="LEFT"/>- _avg_flex(frame): float | None<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "UnknownRepTracker" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#F3ECF8" CELLPADDING="4"><B><FONT POINT-SIZE="13">UnknownRepTracker</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">vision.rep_trackers.unknown</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- _state: RepState<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ update(frame: FeatureFrame): RepState<BR ALIGN="LEFT"/>+ reset(): None<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "nota_squat" [shape=note, style=filled, fillcolor="#FFFBE6", color="#999999", fontsize=10, margin="0.12,0.08", label=<Fases: idle → eccentric (flexión ≥ 55°) → concentric<BR ALIGN="LEFT"/>(pico ≥ 80°) → idle (≤ 35°, +1 repetición).<BR ALIGN="LEFT"/>asymmetry_high si |L − R| / max(L, R) &gt; 18 %;<BR ALIGN="LEFT"/>rom_low si en eccentric el pico queda &lt; 72°.<BR ALIGN="LEFT"/>>];
    "RepState" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" CELLPADDING="4"><FONT POINT-SIZE="10">«dataclass»</FONT><BR/><B><FONT POINT-SIZE="13">RepState</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">vision.types</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ rep_phase: RepPhase = "idle"<BR ALIGN="LEFT"/>+ rep_count: int = 0<BR ALIGN="LEFT"/>+ quality_flags: list[str]<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR></TABLE>>];
  }
  "FeatureEngine" -> "PoseFrame" [dir=both, arrowtail=odiamond, arrowhead=none, style=solid, label=<_window<BR/>(maxlen = window_size_frames)>, taillabel="1", headlabel="0..*", labeldistance=1.6, labelangle=35];
  "FeatureEngine" -> "FeatureFrame" [arrowhead=vee, style=dashed, label=<«create»>];
  "FeatureEngine" -> "ExerciseClassifierConfig" [arrowhead=vee, style=solid, label=<_cfg>, headlabel="1", labeldistance=1.6, labelangle=35];
  "FeatureFrame" -> "PoseFrame" [arrowhead=vee, style=solid, label=<pose>, headlabel="1", labeldistance=1.6, labelangle=35];
  "exercise_classifier" -> "HysteresisClassifier" [arrowhead=vee, style=dashed, label=<«create»>];
  "exercise_classifier" -> "ModelRegistry" [arrowhead=vee, style=dashed, label=<«use»>];
  "ModelRegistry" -> "ExerciseModelManifest" [arrowhead=vee, style=dashed, label=<«create»>];
  "exercise_classifier" -> "_OnnxCls" [arrowhead=vee, style=dashed, label=<«create»>];
  "HysteresisClassifier" -> "ExerciseClassifier" [arrowhead=vee, style=solid, label=<_inner>, headlabel="1", labeldistance=1.6, labelangle=35];
  "HysteresisClassifier" -> "ScalarKalman1D" [dir=both, arrowtail=diamond, arrowhead=none, style=solid, label=<_kalman>, taillabel="1", headlabel="1", labeldistance=1.6, labelangle=35];
  "HysteresisClassifier" -> "ExerciseClassifierConfig" [arrowhead=vee, style=solid, label=<_cfg>, headlabel="1", labeldistance=1.6, labelangle=35, constraint=false];
  "HeuristicExerciseClassifier" -> "ExerciseClassifier" [arrowhead=empty, style=dashed];
  "NopExerciseClassifier" -> "ExerciseClassifier" [arrowhead=empty, style=dashed];
  "_OnnxCls" -> "ExerciseClassifier" [arrowhead=empty, style=dashed];
  "ExerciseClassifier" -> "ClassificationResult" [arrowhead=vee, style=dashed, label=<«create»>];
  "RepTrackerRouter" -> "RepTracker" [dir=both, arrowtail=diamond, arrowhead=none, style=solid, label=<_trackers>, taillabel="1", headlabel="4", labeldistance=1.6, labelangle=35];
  "SquatRepTracker" -> "RepTracker" [arrowhead=empty, style=solid];
  "UnknownRepTracker" -> "RepTracker" [arrowhead=empty, style=solid];
  "FeatureFrame" -> "RepTracker" [arrowhead=vee, style=dashed, label=<«use»>, dir=back, arrowtail=vee, arrowhead=none];
  "RepTracker" -> "RepState" [arrowhead=vee, style=dashed, label=<«create»>];
  "nota_vector" -> "FeatureEngine" [arrowhead=none, style=dashed, color="#888888"];
  "nota_histeresis" -> "HysteresisClassifier" [arrowhead=none, style=dashed, color="#888888"];
  "nota_build" -> "exercise_classifier" [arrowhead=none, style=dashed, color="#888888"];
  "nota_squat" -> "SquatRepTracker" [arrowhead=none, style=dashed, color="#888888"];
  "nota_router" -> "RepTrackerRouter" [arrowhead=none, style=dashed, color="#888888"];
  "PoseFrame" -> "nota_router" [style=invis];
  "PoseFrame" -> "nota_squat" [style=invis];
}
