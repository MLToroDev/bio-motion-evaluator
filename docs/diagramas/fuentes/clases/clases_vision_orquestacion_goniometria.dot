// Diagrama de clases — núcleo de visión: orquestación, pose y goniometría
// Generado por generar_clases.py — no editar a mano.
digraph "clases_vision_orquestacion_goniometria" {
  charset="utf-8";
  graph [rankdir=LR, fontname="Helvetica", fontsize=12, bgcolor="white", nodesep=0.35, ranksep=0.55, pad=0.3, newrank=true];
  node [shape=plain, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10, color="#333333", arrowsize=0.9];
  "RealtimeEngineSession" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#E8F1FB" CELLPADDING="4"><B><FONT POINT-SIZE="13">RealtimeEngineSession</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">vision.realtime_engine</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- _model_path: Path<BR ALIGN="LEFT"/>- _cfg: ExerciseClassifierConfig<BR ALIGN="LEFT"/>- _inference_stride: int<BR ALIGN="LEFT"/>- _analysis_enabled: bool<BR ALIGN="LEFT"/>- _forced_exercise_label: str | None<BR ALIGN="LEFT"/>- _last_pose: PoseFrame | None<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ __init__(backend_root, model_path, classifier_cfg,<BR ALIGN="LEFT"/>      *, inference_stride, analysis_enabled, forced_exercise_label)<BR ALIGN="LEFT"/>+ process_bgr(bgr, frame_index, timestamp_ms): dict<BR ALIGN="LEFT"/>+ process_jpeg(image_bytes, frame_index): dict<BR ALIGN="LEFT"/>+ reset(): None<BR ALIGN="LEFT"/>- _extract_pose(frame_index, bgr, jpeg_bytes, timestamp_ms): PoseFrame<BR ALIGN="LEFT"/>- _after_extract(st, pose, frame_index): dict<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "pose_extractor" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#E8F1FB" CELLPADDING="4"><FONT POINT-SIZE="10">«utility»</FONT><BR/><B><FONT POINT-SIZE="13">pose_extractor</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">vision.pose_extractor</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ extract_pose_jpeg(image_bytes, model_path): PoseFrame<BR ALIGN="LEFT"/>+ extract_pose_bgr(bgr, model_path): PoseFrame<BR ALIGN="LEFT"/>+ extract_pose_bgr_video(bgr, model_path, timestamp_ms): PoseFrame<BR ALIGN="LEFT"/>- _relacion_aspecto(bgr): float | None<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "mediapipe" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#FDEDEC" CELLPADDING="4"><FONT POINT-SIZE="10">«service»</FONT><BR/><B><FONT POINT-SIZE="13">mediapipe</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">app.services.pose.mediapipe</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- _TARGET_MAX_DIM = 640<BR ALIGN="LEFT"/>- _VIDEO_LANDMARKER_LOCK: threading.Lock<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ analyze_image_bytes(image_bytes, model_path): PoseResult<BR ALIGN="LEFT"/>+ analyze_frame_bgr(bgr, model_path): PoseResult<BR ALIGN="LEFT"/>+ analyze_frame_bgr_video(bgr, model_path, timestamp_ms): PoseResult<BR ALIGN="LEFT"/>+ analyze_frame_rgb(rgb, model_path): PoseResult<BR ALIGN="LEFT"/>+ reset_pose_video_timestamp_anchor(): None<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "PoseResult" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#FDEDEC" CELLPADDING="4"><FONT POINT-SIZE="10">«dataclass»</FONT><BR/><B><FONT POINT-SIZE="13">PoseResult</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">app.services.pose.mediapipe</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ ok: bool<BR ALIGN="LEFT"/>+ landmarks: list[dict[str, Any]]<BR ALIGN="LEFT"/>+ world_landmarks: list[dict[str, Any]]<BR ALIGN="LEFT"/>+ note: str | None<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR></TABLE>>];
  "biomechanics" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#E8F1FB" CELLPADDING="4"><FONT POINT-SIZE="10">«utility»</FONT><BR/><B><FONT POINT-SIZE="13">biomechanics</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">vision.biomechanics</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><U>LEFT_HIP = 23, LEFT_KNEE = 25, LEFT_ANKLE = 27</U><BR ALIGN="LEFT"/><U>RIGHT_HIP = 24, RIGHT_KNEE = 26, RIGHT_ANKLE = 28</U><BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ angulos_rodilla(landmarks, world_landmarks, relacion_aspecto)<BR ALIGN="LEFT"/>      : KneeAnglesPayload | None<BR ALIGN="LEFT"/>+ knee_angles_from_landmarks(landmarks): KneeAnglesPayload | None<BR ALIGN="LEFT"/>+ escalar_a_isotropico(landmarks, relacion_aspecto): list[dict]<BR ALIGN="LEFT"/>+ elbow_flex_angles_from_landmarks(landmarks): dict[str, float]<BR ALIGN="LEFT"/>+ shoulder_width_proxy(landmarks): float | None<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "KneeAnglesPayload" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" CELLPADDING="4"><FONT POINT-SIZE="10">«TypedDict»</FONT><BR/><B><FONT POINT-SIZE="13">KneeAnglesPayload</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">vision.biomechanics</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ left_knee_flexion_angle_deg: float<BR ALIGN="LEFT"/>+ right_knee_flexion_angle_deg: float<BR ALIGN="LEFT"/>+ left_knee_internal_angle_deg: float<BR ALIGN="LEFT"/>+ right_knee_internal_angle_deg: float<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR></TABLE>>];
  "PoseFrame" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" CELLPADDING="4"><FONT POINT-SIZE="10">«dataclass»</FONT><BR/><B><FONT POINT-SIZE="13">PoseFrame</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">vision.types</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ ok: bool<BR ALIGN="LEFT"/>+ landmarks: list[dict[str, Any]]<BR ALIGN="LEFT"/>+ note: str | None<BR ALIGN="LEFT"/>+ knees: dict[str, float] | None<BR ALIGN="LEFT"/>+ world_landmarks: list[dict[str, Any]] | None<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR></TABLE>>];
  "unified_payload" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#E8F1FB" CELLPADDING="4"><FONT POINT-SIZE="10">«utility»</FONT><BR/><B><FONT POINT-SIZE="13">unified_payload</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">vision.unified_payload</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><U>SCHEMA_VERSION = 1</U><BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ build_frame_payload_v1(frame_index, pose, exercise_label,<BR ALIGN="LEFT"/>      exercise_confidence, rep, pipeline_ms): dict<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "landmark_filter" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#E8F1FB" CELLPADDING="4"><FONT POINT-SIZE="10">«utility»</FONT><BR/><B><FONT POINT-SIZE="13">landmark_filter</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">vision.landmark_filter</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ landmarks_for_api_response(landmarks, world_landmarks,<BR ALIGN="LEFT"/>      min_visibility): tuple[list | None, list | None]<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "StageTimer" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#EEEEEE" CELLPADDING="4"><FONT POINT-SIZE="10">«dataclass»</FONT><BR/><B><FONT POINT-SIZE="13">StageTimer</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">vision.pipeline_timer</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ timing: PipelineTiming<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ mark_extract() / mark_feature()<BR ALIGN="LEFT"/>+ mark_classify() / mark_track()<BR ALIGN="LEFT"/>+ finish(): PipelineTiming<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "PipelineTiming" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#EEEEEE" CELLPADDING="4"><FONT POINT-SIZE="10">«dataclass»</FONT><BR/><B><FONT POINT-SIZE="13">PipelineTiming</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">vision.pipeline_timer</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ extract_ms, feature_ms, classify_ms: float<BR ALIGN="LEFT"/>+ track_ms, total_ms: float<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ as_dict(): dict[str, float]<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "ExerciseClassifierConfig" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><FONT POINT-SIZE="10">«pydantic»</FONT><BR/><B><FONT POINT-SIZE="13">ExerciseClassifierConfig</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">app.models.schemas · detalle en (a-2)</FONT></TD></TR></TABLE>>];
  "FeatureEngine" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><B><FONT POINT-SIZE="13">FeatureEngine</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">vision.feature_engine · detalle en (a-2)</FONT></TD></TR></TABLE>>];
  "HysteresisClassifier" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><B><FONT POINT-SIZE="13">HysteresisClassifier</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">vision.exercise_classifier · detalle en (a-2)</FONT></TD></TR></TABLE>>];
  "RepTrackerRouter" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><B><FONT POINT-SIZE="13">RepTrackerRouter</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">vision.rep_tracker · detalle en (a-2)</FONT></TD></TR></TABLE>>];
  "RepState" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><FONT POINT-SIZE="10">«dataclass»</FONT><BR/><B><FONT POINT-SIZE="13">RepState</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">vision.types · detalle en (a-2)</FONT></TD></TR></TABLE>>];
  "nota_convencion" [shape=note, style=filled, fillcolor="#FFFBE6", color="#999999", fontsize=10, margin="0.12,0.08", label=<Convención angular (biomechanics):<BR ALIGN="LEFT"/>interno = ∠(rodilla→cadera, rodilla→tobillo) ∈ [0°, 180°]<BR ALIGN="LEFT"/>flexión = min(180°, max(0°, 180° − interno))<BR ALIGN="LEFT"/>0° ≈ extensión completa; a mayor valor, más flexión.<BR ALIGN="LEFT"/>>];
  "nota_espacio" [shape=note, style=filled, fillcolor="#FFFBE6", color="#999999", fontsize=10, margin="0.12,0.08", label=<Espacio de coordenadas de angulos_rodilla()<BR ALIGN="LEFT"/>(docs/spec/goniometria-espacio-de-coordenadas.md):<BR ALIGN="LEFT"/>1) world_landmarks: metros, origen en el punto medio<BR ALIGN="LEFT"/>    de las caderas, isótropo → fuente preferida;<BR ALIGN="LEFT"/>2) landmarks normalizados × (alto / ancho);<BR ALIGN="LEFT"/>3) normalizados sin corregir, solo como último recurso.<BR ALIGN="LEFT"/>La visibilidad se filtra sobre los normalizados.<BR ALIGN="LEFT"/>>];
  "nota_pipeline" [shape=note, style=filled, fillcolor="#FFFBE6", color="#999999", fontsize=10, margin="0.12,0.08", label=<Pipeline por fotograma: extracción de pose → ventana de<BR ALIGN="LEFT"/>características → clasificación con histéresis →<BR ALIGN="LEFT"/>seguimiento de repeticiones → payload v1 (dict JSON).<BR ALIGN="LEFT"/>Con analysis_enabled = False solo se extrae la pose<BR ALIGN="LEFT"/>(_features, _classifier y _router quedan en None).<BR ALIGN="LEFT"/>>];
  "nota_payload" [shape=note, style=filled, fillcolor="#FFFBE6", color="#999999", fontsize=10, margin="0.12,0.08", label=<Payload v1: schema_version, frame_index, pose_ok, note,<BR ALIGN="LEFT"/>landmarks (visibility ≥ umbral), world_landmarks, knees,<BR ALIGN="LEFT"/>exercise_label, exercise_confidence, rep_phase,<BR ALIGN="LEFT"/>rep_count, quality_flags, pipeline_ms.<BR ALIGN="LEFT"/>>];
  "RealtimeEngineSession" -> "pose_extractor" [arrowhead=vee, style=dashed, label=<«use»>];
  "RealtimeEngineSession" -> "FeatureEngine" [dir=both, arrowtail=diamond, arrowhead=none, style=solid, label=<_features>, taillabel="1", headlabel="0..1", labeldistance=1.6, labelangle=35];
  "RealtimeEngineSession" -> "HysteresisClassifier" [dir=both, arrowtail=diamond, arrowhead=none, style=solid, label=<_classifier>, taillabel="1", headlabel="0..1", labeldistance=1.6, labelangle=35];
  "RealtimeEngineSession" -> "RepTrackerRouter" [dir=both, arrowtail=diamond, arrowhead=none, style=solid, label=<_router>, taillabel="1", headlabel="0..1", labeldistance=1.6, labelangle=35];
  "RealtimeEngineSession" -> "ExerciseClassifierConfig" [arrowhead=vee, style=solid, label=<_cfg>, headlabel="1", labeldistance=1.6, labelangle=35];
  "RealtimeEngineSession" -> "StageTimer" [arrowhead=vee, style=dashed, label=<«create»>];
  "RealtimeEngineSession" -> "unified_payload" [arrowhead=vee, style=dashed, label=<«use»>];
  "RealtimeEngineSession" -> "PoseFrame" [arrowhead=vee, style=solid, label=<_last_pose>, headlabel="0..1", labeldistance=1.6, labelangle=35, weight=0];
  "pose_extractor" -> "mediapipe" [arrowhead=vee, style=dashed, label=<«use»>];
  "pose_extractor" -> "biomechanics" [arrowhead=vee, style=dashed, label=<«use»<BR/>angulos_rodilla>];
  "pose_extractor" -> "PoseFrame" [arrowhead=vee, style=dashed, label=<«create»>];
  "mediapipe" -> "PoseResult" [arrowhead=vee, style=dashed, label=<«create»>];
  "biomechanics" -> "KneeAnglesPayload" [arrowhead=vee, style=dashed, label=<«create»>];
  "PoseFrame" -> "KneeAnglesPayload" [arrowhead=vee, style=solid, headlabel="knees 0..1", labeldistance=1.6, labelangle=35, constraint=false];
  "StageTimer" -> "PipelineTiming" [dir=both, arrowtail=diamond, arrowhead=none, style=solid, label=<timing>, taillabel="1", headlabel="1", labeldistance=1.6, labelangle=35];
  "unified_payload" -> "landmark_filter" [arrowhead=vee, style=dashed, label=<«use»>];
  "unified_payload" -> "PoseFrame" [arrowhead=vee, style=dashed, label=<«use»>];
  "unified_payload" -> "RepState" [arrowhead=vee, style=dashed, label=<«use»>];
  "nota_convencion" -> "biomechanics" [arrowhead=none, style=dashed, color="#888888"];
  "nota_espacio" -> "biomechanics" [arrowhead=none, style=dashed, color="#888888"];
  "nota_pipeline" -> "RealtimeEngineSession" [arrowhead=none, style=dashed, color="#888888"];
  "nota_payload" -> "unified_payload" [arrowhead=none, style=dashed, color="#888888"];
}
