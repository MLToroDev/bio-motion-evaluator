  "AnalysisSummaryDialog" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#EAF6EC" CELLPADDING="4"><FONT POINT-SIZE="10">«component»</FONT><BR/><B><FONT POINT-SIZE="13">AnalysisSummaryDialog</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">components/AnalysisSummaryDialog.tsx</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ summary: AnalysisSummary | null<BR ALIGN="LEFT"/>+ open: boolean<BR ALIGN="LEFT"/>+ onClose: () =&gt; void<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR></TABLE>>];
  "poseWsPayload" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#F3ECF8" CELLPADDING="4"><FONT POINT-SIZE="10">«module»</FONT><BR/><B><FONT POINT-SIZE="13">poseWsPayload</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">lib/poseWsPayload.ts</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ poseWsErrorMessage(map): string | null<BR ALIGN="LEFT"/>+ parseLandmarksJson(raw): LandmarkMap[] | null<BR ALIGN="LEFT"/>+ parseKneesMap(raw) / parseDeg(v) / parseFrameIndex(raw)<BR ALIGN="LEFT"/>+ parseQualityFlags(raw) / pipelineTotalMs(map)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "angleFormatter" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#F3ECF8" CELLPADDING="4"><FONT POINT-SIZE="10">«module»</FONT><BR/><B><FONT POINT-SIZE="13">angleFormatter / angleRanges</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">lib/angleFormatter.ts · lib/angleRanges.ts</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><U>squatFlexGoodMinDeg = 80, squatFlexGoodMaxDeg = 100</U><BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ statusForKneeFlexionInContext(deg, isLeftLeg, exerciseLabel,<BR ALIGN="LEFT"/>      otherLegDeg): MetricStatus<BR ALIGN="LEFT"/>+ kneeFlexionMetricSublabelInContext(...): string<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "MetricStatus" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" CELLPADDING="4"><FONT POINT-SIZE="10">«type»</FONT><BR/><B><FONT POINT-SIZE="13">MetricStatus</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">lib/metricStatus.ts</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">'good' | 'warn' | 'bad' | 'neutral'<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR></TABLE>>];
  "ws_video" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><FONT POINT-SIZE="10">«WebSocket»</FONT><BR/><B><FONT POINT-SIZE="13">/ws/video</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">backend · app.api.websocket.video</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">→ {analyze_pose, capture_only, forced_exercise_label}<BR ALIGN="LEFT"/>→ JPEG binario · ← payload v1 (JSON)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "ws_pose" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><FONT POINT-SIZE="10">«WebSocket»</FONT><BR/><B><FONT POINT-SIZE="13">/ws/pose-stream</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">backend · app.api.websocket.live_pose</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">→ PoseStreamConfig · ← stream_profile,<BR ALIGN="LEFT"/>    payload v1 + preview_jpeg_base64, stream_done<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "rest_gold" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><FONT POINT-SIZE="10">«REST»</FONT><BR/><B><FONT POINT-SIZE="13">GET /api/v1/analysis/gold-standard-videos</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">backend · app.api.v1.gold_standard_videos</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">← {filenames: string[]}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "nota_rutas" [shape=note, style=filled, fillcolor="#FFFBE6", color="#999999", fontsize=10, margin="0.12,0.08", label=<Interfaz principal: / redirige a /sustentacion (tema claro).<BR ALIGN="LEFT"/>Demo usa useLiveAnalysisSession(apiBase, false, null):<BR ALIGN="LEFT"/>rodilla izquierda/derecha y asimetría bilateral |L − R|,<BR ALIGN="LEFT"/>rotulada «no interpretable» por debajo de 5°.<BR ALIGN="LEFT"/>La interfaz completa (/inicio, tema oscuro) conserva el<BR ALIGN="LEFT"/>análisis de video, el diagnóstico y la configuración.<BR ALIGN="LEFT"/>Layout → página: ruta hija (la ruta va en el subtítulo).<BR ALIGN="LEFT"/>>];
  "nota_live" [shape=note, style=filled, fillcolor="#FFFBE6", color="#999999", fontsize=10, margin="0.12,0.08", label=<Análisis en vivo: getUserMedia → captura JPEG a 30 Hz con<BR ALIGN="LEFT"/>contrapresión (máx. 3 fotogramas sin respuesta) → /ws/video.<BR ALIGN="LEFT"/>El video se muestra en espejo solo por CSS; el JPEG se<BR ALIGN="LEFT"/>envía sin espejar y el overlay usa mirrorHorizontal.<BR ALIGN="LEFT"/>>];
  "nota_overlay" [shape=note, style=filled, fillcolor="#FFFBE6", color="#999999", fontsize=10, margin="0.12,0.08", label=<Con smoothMotion = true se lee landmarksRef de forma<BR ALIGN="LEFT"/>imperativa (sin setState) e interpola entre poses.<BR ALIGN="LEFT"/>Si llega un payload sin landmarks se conserva el último.<BR ALIGN="LEFT"/>>];
  "nota_estado" [shape=note, style=filled, fillcolor="#FFFBE6", color="#999999", fontsize=10, margin="0.12,0.08", label=<Estado por pierna (MetricStatus): sentadilla 80–100° de<BR ALIGN="LEFT"/>flexión = good; zancada distingue pierna delantera y<BR ALIGN="LEFT"/>trasera comparando con otherLegDeg.<BR ALIGN="LEFT"/>>];
  "router" -> "SustentacionLayout" [dir=both, arrowtail=diamond, arrowhead=none, style=solid, label=</sustentacion>, taillabel="1", headlabel="1", labeldistance=1.6, labelangle=35];
  "router" -> "AppLayout" [dir=both, arrowtail=diamond, arrowhead=none, style=solid, label=<interfaz completa>, taillabel="1", headlabel="1", labeldistance=1.6, labelangle=35];
