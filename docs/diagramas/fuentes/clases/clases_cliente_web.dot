  "useLiveAnalysisSession" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#E8F1FB" CELLPADDING="4"><FONT POINT-SIZE="10">«hook»</FONT><BR/><B><FONT POINT-SIZE="13">useLiveAnalysisSession</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">hooks/useLiveAnalysisSession.ts</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ ui: LiveAnalysisUiState<BR ALIGN="LEFT"/>+ videoRef: RefObject&lt;HTMLVideoElement&gt;<BR ALIGN="LEFT"/>+ overlayLandmarksRef: RefObject&lt;LandmarkMap[] | null&gt;<BR ALIGN="LEFT"/>- wsRef: RefObject&lt;WebSocket | null&gt;<BR ALIGN="LEFT"/><U>MAX_IN_FLIGHT = 3, CAPTURE_HZ = 30, JPEG_QUALITY = 0.6</U><BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ useLiveAnalysisSession(apiBase, captureOnly, forcedExerciseLabel)<BR ALIGN="LEFT"/>+ startCamera(): Promise&lt;void&gt;<BR ALIGN="LEFT"/>+ stopCamera(): void<BR ALIGN="LEFT"/>+ startTransmit(): Promise&lt;void&gt;<BR ALIGN="LEFT"/>+ stopTransmit(): void<BR ALIGN="LEFT"/>+ statusForLeft(ex) / statusForRight(ex): MetricStatus<BR ALIGN="LEFT"/>- sendOneFrame(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
