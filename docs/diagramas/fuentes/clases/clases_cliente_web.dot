  "PoseSkeleton3DPanel" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#EAF6EC" CELLPADDING="4"><FONT POINT-SIZE="10">«component»</FONT><BR/><B><FONT POINT-SIZE="13">PoseSkeleton3DPanel</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">components/pose3d/PoseSkeleton3DPanel.tsx (Three.js)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ landmarks: LandmarkMap[] | null<BR ALIGN="LEFT"/>+ worldLandmarks: LandmarkMap[] | null<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR></TABLE>>];
