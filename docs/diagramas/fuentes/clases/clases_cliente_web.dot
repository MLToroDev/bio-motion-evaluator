  "LiveAnalysis" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#EAF6EC" CELLPADDING="4"><FONT POINT-SIZE="10">«page»</FONT><BR/><B><FONT POINT-SIZE="13">LiveAnalysis</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">pages/LiveAnalysis/LiveAnalysis.tsx</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- exerciseMode: LiveExerciseMode  ('auto' | 'idle' | 'squat' | 'lunge')<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ LiveAnalysis(): JSX.Element  (ruta /live-analysis)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
