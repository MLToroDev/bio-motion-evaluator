// Diagrama de clases — cliente web appWeb (rutas, páginas, hooks, componentes y contratos)
// Generado por generar_clases.py — no editar a mano.
digraph "clases_cliente_web" {
  charset="utf-8";
  graph [rankdir=TB, fontname="Helvetica", fontsize=12, bgcolor="white", nodesep=0.35, ranksep=0.55, pad=0.3, newrank=true];
  node [shape=plain, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10, color="#333333", arrowsize=0.9];
  "router" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#EEEEEE" CELLPADDING="4"><FONT POINT-SIZE="10">«module»</FONT><BR/><B><FONT POINT-SIZE="13">router</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">router.tsx</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ / → &lt;Navigate to="/sustentacion" replace&gt;<BR ALIGN="LEFT"/>+ /sustentacion → SustentacionLayout  (interfaz principal)<BR ALIGN="LEFT"/>+ (sin prefijo) → AppLayout  (interfaz completa)<BR ALIGN="LEFT"/>+ login, sessions, profile, video-download → MvpRouteGuard<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ App(): JSX.Element  (RouterProvider)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "SustentacionLayout" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#EAF6EC" CELLPADDING="4"><FONT POINT-SIZE="10">«layout»</FONT><BR/><B><FONT POINT-SIZE="13">SustentacionLayout</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">pages/sustentacion/SustentacionLayout.tsx</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- TOKENS_CLAROS: Record&lt;string, string&gt;<BR ALIGN="LEFT"/>- ENLACES: Inicio, Demostración, Resultados<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ SustentacionLayout(): JSX.Element  (tema claro, enlace «Interfaz completa →»)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "AppLayout" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#EAF6EC" CELLPADDING="4"><FONT POINT-SIZE="10">«layout»</FONT><BR/><B><FONT POINT-SIZE="13">AppLayout</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#555555">layouts/AppLayout.tsx</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ AppLayout(): JSX.Element  (tema oscuro, barra lateral)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
