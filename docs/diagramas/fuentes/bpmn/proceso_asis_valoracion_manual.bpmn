<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Def_AsIsValoracionManual" name="Proceso AS-IS de valoración manual del rango de movimiento de rodilla" targetNamespace="https://bio-motion-evaluator/bpmn" exporter="bio-motion-evaluator generar_bpmn.py" exporterVersion="1.0">
  <bpmn:collaboration id="Colab_Def_AsIsValoracionManual">
    <bpmn:participant id="P_AsIs" name="Valoración funcional de rodilla sin el sistema (proceso actual)" processRef="Proceso_P_AsIs" />
  </bpmn:collaboration>
  <bpmn:process id="Proceso_P_AsIs" name="Valoración manual de rodilla" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P_AsIs">
      <bpmn:lane id="L_Evaluado" name="Evaluado (deportista)">
        <bpmn:flowNodeRef>eo_inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eo_gw_acceso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eo_omitir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eo_generica</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eo_pagar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eo_asistir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eo_posicion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eo_adaptar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eo_gw_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eo_entrenar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eo_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Evaluador" name="Evaluador (profesional)">
        <bpmn:flowNodeRef>er_gw_instr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>er_alinear</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>er_leer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>er_grabar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>er_marcar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>er_gw_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>er_interpretar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>er_comunicar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Herramienta" name="Herramienta manual (goniómetro / video y Kinovea)">
        <bpmn:flowNodeRef>hm_gonio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hm_kinovea</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hm_angulo</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="eo_inicio" name="Necesidad de entrenar: fase de valoración funcional">
      <bpmn:outgoing>Flujo_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="eo_gw_acceso" name="¿Accede a una valoración profesional?" default="Flujo_02">
      <bpmn:incoming>Flujo_01</bpmn:incoming>
      <bpmn:outgoing>Flujo_02</bpmn:outgoing>
      <bpmn:outgoing>Flujo_03</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="eo_omitir" name="Omitir la valoración funcional">
      <bpmn:incoming>Flujo_03</bpmn:incoming>
      <bpmn:outgoing>Flujo_04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="eo_generica" name="Calentar con una rutina de movilidad genérica, «a ciegas»">
      <bpmn:incoming>Flujo_04</bpmn:incoming>
      <bpmn:outgoing>Flujo_05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="eo_pagar" name="Solicitar y pagar la consulta profesional">
      <bpmn:incoming>Flujo_02</bpmn:incoming>
      <bpmn:outgoing>Flujo_06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="eo_asistir" name="Asistir a la consulta presencial">
      <bpmn:incoming>Flujo_06</bpmn:incoming>
      <bpmn:outgoing>Flujo_07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="er_gw_instr" name="¿Instrumento de medición?" default="Flujo_08">
      <bpmn:incoming>Flujo_07</bpmn:incoming>
      <bpmn:outgoing>Flujo_08</bpmn:outgoing>
      <bpmn:outgoing>Flujo_09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="eo_posicion" name="Adoptar y mantener la posición de medición">
      <bpmn:incoming>Flujo_08</bpmn:incoming>
      <bpmn:outgoing>Flujo_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="er_alinear" name="Alinear el goniómetro con cadera, rodilla y tobillo">
      <bpmn:incoming>Flujo_10</bpmn:incoming>
      <bpmn:outgoing>Flujo_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="hm_gonio" name="Goniómetro universal: el ángulo se lee en la escala">
      <bpmn:incoming>Flujo_11</bpmn:incoming>
      <bpmn:outgoing>Flujo_12</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="er_leer" name="Leer y anotar el ángulo">
      <bpmn:incoming>Flujo_12</bpmn:incoming>
      <bpmn:outgoing>Flujo_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="er_grabar" name="Grabar en video al evaluado mientras ejecuta el movimiento">
      <bpmn:incoming>Flujo_09</bpmn:incoming>
      <bpmn:outgoing>Flujo_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="hm_kinovea" name="Kinovea: abrir el video y avanzar al fotograma de interés">
      <bpmn:incoming>Flujo_14</bpmn:incoming>
      <bpmn:outgoing>Flujo_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="er_marcar" name="Marcar a mano las tres referencias (cadera, rodilla, tobillo)">
      <bpmn:incoming>Flujo_15</bpmn:incoming>
      <bpmn:outgoing>Flujo_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="hm_angulo" name="Kinovea: calcular el ángulo plano entre los dos brazos">
      <bpmn:incoming>Flujo_16</bpmn:incoming>
      <bpmn:outgoing>Flujo_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="er_gw_merge">
      <bpmn:incoming>Flujo_13</bpmn:incoming>
      <bpmn:incoming>Flujo_17</bpmn:incoming>
      <bpmn:outgoing>Flujo_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="er_interpretar" name="Interpretar la medida (juicio cualitativo del profesional)">
      <bpmn:incoming>Flujo_18</bpmn:incoming>
      <bpmn:outgoing>Flujo_19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="er_comunicar" name="Comunicar los hallazgos al evaluado">
      <bpmn:incoming>Flujo_19</bpmn:incoming>
      <bpmn:outgoing>Flujo_20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="eo_adaptar" name="Adaptar el calentamiento según las indicaciones">
      <bpmn:incoming>Flujo_20</bpmn:incoming>
      <bpmn:outgoing>Flujo_21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="eo_gw_merge">
      <bpmn:incoming>Flujo_05</bpmn:incoming>
      <bpmn:incoming>Flujo_21</bpmn:incoming>
      <bpmn:outgoing>Flujo_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="eo_entrenar" name="Ejecutar el entrenamiento (ejercicios de alta carga)">
      <bpmn:incoming>Flujo_22</bpmn:incoming>
      <bpmn:outgoing>Flujo_23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="eo_fin" name="Entrenamiento realizado">
      <bpmn:incoming>Flujo_23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flujo_01" sourceRef="eo_inicio" targetRef="eo_gw_acceso" />
    <bpmn:sequenceFlow id="Flujo_02" name="Sí" sourceRef="eo_gw_acceso" targetRef="eo_pagar" />
    <bpmn:sequenceFlow id="Flujo_03" name="No" sourceRef="eo_gw_acceso" targetRef="eo_omitir">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">costo o falta de un profesional disponible</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flujo_04" sourceRef="eo_omitir" targetRef="eo_generica" />
    <bpmn:sequenceFlow id="Flujo_05" sourceRef="eo_generica" targetRef="eo_gw_merge" />
    <bpmn:sequenceFlow id="Flujo_06" sourceRef="eo_pagar" targetRef="eo_asistir" />
    <bpmn:sequenceFlow id="Flujo_07" sourceRef="eo_asistir" targetRef="er_gw_instr" />
    <bpmn:sequenceFlow id="Flujo_08" name="Goniómetro" sourceRef="er_gw_instr" targetRef="eo_posicion" />
    <bpmn:sequenceFlow id="Flujo_09" name="Video" sourceRef="er_gw_instr" targetRef="er_grabar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">video-goniometría manual (Kinovea)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flujo_10" sourceRef="eo_posicion" targetRef="er_alinear" />
    <bpmn:sequenceFlow id="Flujo_11" sourceRef="er_alinear" targetRef="hm_gonio" />
    <bpmn:sequenceFlow id="Flujo_12" sourceRef="hm_gonio" targetRef="er_leer" />
    <bpmn:sequenceFlow id="Flujo_13" sourceRef="er_leer" targetRef="er_gw_merge" />
    <bpmn:sequenceFlow id="Flujo_14" sourceRef="er_grabar" targetRef="hm_kinovea" />
    <bpmn:sequenceFlow id="Flujo_15" sourceRef="hm_kinovea" targetRef="er_marcar" />
    <bpmn:sequenceFlow id="Flujo_16" sourceRef="er_marcar" targetRef="hm_angulo" />
    <bpmn:sequenceFlow id="Flujo_17" sourceRef="hm_angulo" targetRef="er_gw_merge" />
    <bpmn:sequenceFlow id="Flujo_18" sourceRef="er_gw_merge" targetRef="er_interpretar" />
    <bpmn:sequenceFlow id="Flujo_19" sourceRef="er_interpretar" targetRef="er_comunicar" />
    <bpmn:sequenceFlow id="Flujo_20" sourceRef="er_comunicar" targetRef="eo_adaptar" />
    <bpmn:sequenceFlow id="Flujo_21" sourceRef="eo_adaptar" targetRef="eo_gw_merge" />
    <bpmn:sequenceFlow id="Flujo_22" sourceRef="eo_gw_merge" targetRef="eo_entrenar" />
    <bpmn:sequenceFlow id="Flujo_23" sourceRef="eo_entrenar" targetRef="eo_fin" />
    <bpmn:textAnnotation id="an_acceso"><bpmn:text>Barrera de costo y de atención presencial: la valoración funcional suele omitirse.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Asoc_an_acceso" associationDirection="None" sourceRef="eo_gw_acceso" targetRef="an_acceso" />
    <bpmn:textAnnotation id="an_gonio"><bpmn:text>Goniometría manual: error típico ≈ 3,4° en flexión de rodilla (Mehta et al., 2017).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Asoc_an_gonio" associationDirection="None" sourceRef="hm_gonio" targetRef="an_gonio" />
    <bpmn:textAnnotation id="an_kinovea"><bpmn:text>Video-goniometría manual 2D, la que usa la Facultad de Educación Física (§ 2.3.3).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Asoc_an_kinovea" associationDirection="None" sourceRef="hm_kinovea" targetRef="an_kinovea" />
    <bpmn:textAnnotation id="an_variab"><bpmn:text>Concordancia entre evaluadores limitada: límites de acuerdo &gt; 18° con otros instrumentos.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Asoc_an_variab" associationDirection="None" sourceRef="er_interpretar" targetRef="an_variab" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagrama_Def_AsIsValoracionManual" name="Proceso AS-IS de valoración manual del rango de movimiento de rodilla">
    <bpmndi:BPMNPlane id="Plano_Def_AsIsValoracionManual" bpmnElement="Colab_Def_AsIsValoracionManual">
