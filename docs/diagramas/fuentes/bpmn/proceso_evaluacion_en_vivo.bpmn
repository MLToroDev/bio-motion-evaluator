<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Def_EvaluacionEnVivo" name="Proceso de evaluación goniométrica en vivo" targetNamespace="https://bio-motion-evaluator/bpmn" exporter="bio-motion-evaluator generar_bpmn.py" exporterVersion="1.0">
  <bpmn:error id="Err_Camara" name="Cámara no disponible" />
  <bpmn:error id="Err_Conexion" name="Servidor no disponible" />
  <bpmn:error id="Err_Config" name="Primer mensaje inválido" />
  <bpmn:collaboration id="Colab_Def_EvaluacionEnVivo">
    <bpmn:participant id="P_Sesion" name="Sesión de medición en vivo — appWeb (/sustentacion/demo)" processRef="Proceso_P_Sesion" />
    <bpmn:participant id="P_Servidor" name="Servidor de inferencia — FastAPI, WebSocket /ws/video" processRef="Proceso_P_Servidor" />
    <bpmn:messageFlow id="Mensaje_01" name="Apertura" sourceRef="cl_ws" targetRef="sv_inicio" />
    <bpmn:messageFlow id="Mensaje_02" name="Configuración" sourceRef="cl_init" targetRef="sv_cfg" />
    <bpmn:messageFlow id="Mensaje_03" name="JPEG binario" sourceRef="cl_enviar" targetRef="sv_jpeg" />
    <bpmn:messageFlow id="Mensaje_04" name="Payload v1" sourceRef="sv_enviar" targetRef="cl_recibir" />
    <bpmn:messageFlow id="Mensaje_05" name="{error}" sourceRef="sv_err_cfg" targetRef="cl_recibir" />
    <bpmn:messageFlow id="Mensaje_06" name="Cierre" sourceRef="cl_cerrar" targetRef="sv_desconexion" />
  </bpmn:collaboration>
  <bpmn:process id="Proceso_P_Sesion" name="Medición en vivo" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P_Sesion">
      <bpmn:lane id="L_Evaluador" name="Evaluador">
        <bpmn:flowNodeRef>ev_inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_abrir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_ubicar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_mover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_observar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_detener</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_apagar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Cliente" name="Cliente web (appWeb /sustentacion/demo · useLiveAnalysisSession)">
        <bpmn:flowNodeRef>cl_camara</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cl_gw_permiso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cl_err_camara</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cl_fin_camara</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cl_vista</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cl_ws</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cl_gw_con</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cl_err_con</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cl_fin_con</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cl_init</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cl_fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cl_enviar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cl_gw_bucle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cl_recibir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cl_gw_error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cl_err_ws</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cl_fin_ws</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cl_gw_pose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cl_actualizar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cl_asimetria</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cl_sin_datos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cl_gw_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cl_gw_activa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cl_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cl_cerrar</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ev_inicio" name="Medición de rodilla solicitada">
      <bpmn:outgoing>Flujo_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="ev_abrir" name="Abrir «Demostración» y pulsar «Conectar cámara»">
      <bpmn:incoming>Flujo_01</bpmn:incoming>
      <bpmn:outgoing>Flujo_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="ev_ubicar" name="Colocarse de cuerpo entero, a 2–3 m y de perfil; pulsar «Iniciar medición»">
      <bpmn:incoming>Flujo_07</bpmn:incoming>
      <bpmn:outgoing>Flujo_08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="ev_mover" name="Ejecutar el movimiento (p. ej. sentadilla)">
      <bpmn:incoming>Flujo_14</bpmn:incoming>
      <bpmn:outgoing>Flujo_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="ev_observar" name="Leer rodilla izquierda, rodilla derecha y asimetría bilateral">
      <bpmn:incoming>Flujo_17</bpmn:incoming>
      <bpmn:outgoing>Flujo_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="ev_detener" name="Pulsar «Detener medición»">
      <bpmn:incoming>Flujo_18</bpmn:incoming>
      <bpmn:outgoing>Flujo_19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="ev_apagar" name="Pulsar «Apagar cámara»">
      <bpmn:incoming>Flujo_35</bpmn:incoming>
      <bpmn:outgoing>Flujo_36</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="ev_fin" name="Medición finalizada">
      <bpmn:incoming>Flujo_36</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="cl_camara" name="Solicitar permiso de cámara (getUserMedia, 640×480)">
      <bpmn:incoming>Flujo_02</bpmn:incoming>
      <bpmn:outgoing>Flujo_03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="cl_gw_permiso" name="¿Permiso concedido?" default="Flujo_04">
      <bpmn:incoming>Flujo_03</bpmn:incoming>
      <bpmn:outgoing>Flujo_04</bpmn:outgoing>
      <bpmn:outgoing>Flujo_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="cl_err_camara" name="Mostrar error de cámara (usar https o localhost)">
      <bpmn:incoming>Flujo_05</bpmn:incoming>
      <bpmn:outgoing>Flujo_06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="cl_fin_camara" name="Cámara no disponible">
      <bpmn:incoming>Flujo_06</bpmn:incoming>
      <bpmn:errorEventDefinition id="Def_cl_fin_camara" errorRef="Err_Camara" />
    </bpmn:endEvent>
    <bpmn:task id="cl_vista" name="Mostrar la vista previa en espejo (CSS)">
      <bpmn:incoming>Flujo_04</bpmn:incoming>
      <bpmn:outgoing>Flujo_07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="cl_ws" name="Abrir WebSocket /ws/video (espera máx. 8 s)">
      <bpmn:incoming>Flujo_08</bpmn:incoming>
      <bpmn:outgoing>Flujo_09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="cl_gw_con" name="¿Conexión establecida?" default="Flujo_10">
      <bpmn:incoming>Flujo_09</bpmn:incoming>
      <bpmn:outgoing>Flujo_10</bpmn:outgoing>
      <bpmn:outgoing>Flujo_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="cl_err_con" name="Mostrar «No se pudo conectar»">
      <bpmn:incoming>Flujo_11</bpmn:incoming>
      <bpmn:outgoing>Flujo_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="cl_fin_con" name="Servidor no disponible">
      <bpmn:incoming>Flujo_12</bpmn:incoming>
      <bpmn:errorEventDefinition id="Def_cl_fin_con" errorRef="Err_Conexion" />
    </bpmn:endEvent>
    <bpmn:sendTask id="cl_init" name="Enviar configuración inicial {analyze_pose: true}">
      <bpmn:incoming>Flujo_10</bpmn:incoming>
      <bpmn:outgoing>Flujo_13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:parallelGateway id="cl_fork">
      <bpmn:incoming>Flujo_13</bpmn:incoming>
      <bpmn:outgoing>Flujo_14</bpmn:outgoing>
      <bpmn:outgoing>Flujo_15</bpmn:outgoing>
      <bpmn:outgoing>Flujo_16</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sendTask id="cl_enviar" name="Capturar y enviar fotograma JPEG (30 Hz, máx. 3 sin respuesta)">
      <bpmn:incoming>Flujo_16</bpmn:incoming>
      <bpmn:outgoing>Flujo_20</bpmn:outgoing>
      <bpmn:standardLoopCharacteristics id="Bucle_cl_enviar" />
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="cl_gw_bucle">
      <bpmn:incoming>Flujo_15</bpmn:incoming>
      <bpmn:incoming>Flujo_32</bpmn:incoming>
      <bpmn:outgoing>Flujo_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:receiveTask id="cl_recibir" name="Recibir payload JSON del fotograma">
      <bpmn:incoming>Flujo_21</bpmn:incoming>
      <bpmn:outgoing>Flujo_22</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="cl_gw_error" name="¿Mensaje con error?" default="Flujo_23">
      <bpmn:incoming>Flujo_22</bpmn:incoming>
      <bpmn:outgoing>Flujo_23</bpmn:outgoing>
      <bpmn:outgoing>Flujo_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="cl_err_ws" name="Mostrar el error y detener la medición">
      <bpmn:incoming>Flujo_24</bpmn:incoming>
      <bpmn:outgoing>Flujo_25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="cl_fin_ws" name="Medición interrumpida">
      <bpmn:incoming>Flujo_25</bpmn:incoming>
      <bpmn:terminateEventDefinition id="Def_cl_fin_ws" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="cl_gw_pose" name="¿Llegaron landmarks y ángulos?" default="Flujo_26">
      <bpmn:incoming>Flujo_23</bpmn:incoming>
      <bpmn:outgoing>Flujo_26</bpmn:outgoing>
      <bpmn:outgoing>Flujo_27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="cl_actualizar" name="Actualizar esqueleto 2D y lecturas de rodilla izquierda y derecha">
      <bpmn:incoming>Flujo_26</bpmn:incoming>
      <bpmn:outgoing>Flujo_28</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="cl_asimetria" name="Calcular asimetría bilateral |izq. − der.| y contrastarla con 5°">
      <bpmn:incoming>Flujo_28</bpmn:incoming>
      <bpmn:outgoing>Flujo_29</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="cl_sin_datos" name="Conservar el último esqueleto; lecturas «—»">
      <bpmn:incoming>Flujo_27</bpmn:incoming>
      <bpmn:outgoing>Flujo_30</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="cl_gw_merge">
      <bpmn:incoming>Flujo_29</bpmn:incoming>
      <bpmn:incoming>Flujo_30</bpmn:incoming>
      <bpmn:outgoing>Flujo_31</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="cl_gw_activa" name="¿Medición activa?" default="Flujo_32">
      <bpmn:incoming>Flujo_31</bpmn:incoming>
      <bpmn:outgoing>Flujo_32</bpmn:outgoing>
      <bpmn:outgoing>Flujo_33</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="cl_join">
      <bpmn:incoming>Flujo_19</bpmn:incoming>
      <bpmn:incoming>Flujo_20</bpmn:incoming>
      <bpmn:incoming>Flujo_33</bpmn:incoming>
      <bpmn:outgoing>Flujo_34</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="cl_cerrar" name="Cerrar el WebSocket y reiniciar las lecturas">
      <bpmn:incoming>Flujo_34</bpmn:incoming>
      <bpmn:outgoing>Flujo_35</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flujo_01" sourceRef="ev_inicio" targetRef="ev_abrir" />
    <bpmn:sequenceFlow id="Flujo_02" sourceRef="ev_abrir" targetRef="cl_camara" />
    <bpmn:sequenceFlow id="Flujo_03" sourceRef="cl_camara" targetRef="cl_gw_permiso" />
    <bpmn:sequenceFlow id="Flujo_04" name="Sí" sourceRef="cl_gw_permiso" targetRef="cl_vista" />
    <bpmn:sequenceFlow id="Flujo_05" name="No" sourceRef="cl_gw_permiso" targetRef="cl_err_camara">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">permiso denegado o error de getUserMedia</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flujo_06" sourceRef="cl_err_camara" targetRef="cl_fin_camara" />
    <bpmn:sequenceFlow id="Flujo_07" sourceRef="cl_vista" targetRef="ev_ubicar" />
    <bpmn:sequenceFlow id="Flujo_08" sourceRef="ev_ubicar" targetRef="cl_ws" />
    <bpmn:sequenceFlow id="Flujo_09" sourceRef="cl_ws" targetRef="cl_gw_con" />
    <bpmn:sequenceFlow id="Flujo_10" name="Sí" sourceRef="cl_gw_con" targetRef="cl_init" />
    <bpmn:sequenceFlow id="Flujo_11" name="No" sourceRef="cl_gw_con" targetRef="cl_err_con">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">onerror o timeout de 8 s</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flujo_12" sourceRef="cl_err_con" targetRef="cl_fin_con" />
    <bpmn:sequenceFlow id="Flujo_13" sourceRef="cl_init" targetRef="cl_fork" />
    <bpmn:sequenceFlow id="Flujo_14" sourceRef="cl_fork" targetRef="ev_mover" />
    <bpmn:sequenceFlow id="Flujo_15" sourceRef="cl_fork" targetRef="cl_gw_bucle" />
    <bpmn:sequenceFlow id="Flujo_16" sourceRef="cl_fork" targetRef="cl_enviar" />
    <bpmn:sequenceFlow id="Flujo_17" sourceRef="ev_mover" targetRef="ev_observar" />
    <bpmn:sequenceFlow id="Flujo_18" sourceRef="ev_observar" targetRef="ev_detener" />
    <bpmn:sequenceFlow id="Flujo_19" sourceRef="ev_detener" targetRef="cl_join" />
    <bpmn:sequenceFlow id="Flujo_20" sourceRef="cl_enviar" targetRef="cl_join" />
    <bpmn:sequenceFlow id="Flujo_21" sourceRef="cl_gw_bucle" targetRef="cl_recibir" />
    <bpmn:sequenceFlow id="Flujo_22" sourceRef="cl_recibir" targetRef="cl_gw_error" />
    <bpmn:sequenceFlow id="Flujo_23" name="No" sourceRef="cl_gw_error" targetRef="cl_gw_pose" />
    <bpmn:sequenceFlow id="Flujo_24" name="Sí" sourceRef="cl_gw_error" targetRef="cl_err_ws">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">el payload trae error (distinto de sin_frame)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flujo_25" sourceRef="cl_err_ws" targetRef="cl_fin_ws" />
    <bpmn:sequenceFlow id="Flujo_26" name="Sí" sourceRef="cl_gw_pose" targetRef="cl_actualizar" />
    <bpmn:sequenceFlow id="Flujo_27" name="No" sourceRef="cl_gw_pose" targetRef="cl_sin_datos">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">landmarks vacíos o knees = null</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flujo_28" sourceRef="cl_actualizar" targetRef="cl_asimetria" />
    <bpmn:sequenceFlow id="Flujo_29" sourceRef="cl_asimetria" targetRef="cl_gw_merge" />
    <bpmn:sequenceFlow id="Flujo_30" sourceRef="cl_sin_datos" targetRef="cl_gw_merge" />
    <bpmn:sequenceFlow id="Flujo_31" sourceRef="cl_gw_merge" targetRef="cl_gw_activa" />
    <bpmn:sequenceFlow id="Flujo_32" name="Sí" sourceRef="cl_gw_activa" targetRef="cl_gw_bucle" />
    <bpmn:sequenceFlow id="Flujo_33" name="No" sourceRef="cl_gw_activa" targetRef="cl_join">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">se pulsó «Detener medición» o el servidor cerró</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flujo_34" sourceRef="cl_join" targetRef="cl_cerrar" />
    <bpmn:sequenceFlow id="Flujo_35" sourceRef="cl_cerrar" targetRef="ev_apagar" />
    <bpmn:sequenceFlow id="Flujo_36" sourceRef="ev_apagar" targetRef="ev_fin" />
    <bpmn:textAnnotation id="an_lecturas"><bpmn:text>Lecturas en pantalla: rodilla izquierda y derecha (flexión; 0° = extensión) con color por estado, asimetría bilateral y telemetría (RX/s, RTT, motor, fotograma). Con asimetría &lt; 5° (piso de ruido) se rotula «no interpretable».</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Asoc_an_lecturas" associationDirection="None" sourceRef="cl_asimetria" targetRef="an_lecturas" />
    <bpmn:textAnnotation id="an_envio"><bpmn:text>Bucle hasta «Detener medición»: un JPEG (calidad 0,6) sin espejar cada 1/30 s, si hay menos de 3 en vuelo.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Asoc_an_envio" associationDirection="None" sourceRef="cl_enviar" targetRef="an_envio" />
    <bpmn:textAnnotation id="an_completa"><bpmn:text>Interfaz completa (/live-analysis, tema oscuro): mismo hook y mismo servidor; añade el selector de ejercicio (forced_exercise_label) y el panel con pestañas de métricas, registro e histórico, con conteo de repeticiones.</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:process id="Proceso_P_Servidor" name="Inferencia por fotograma" isExecutable="false">
    <bpmn:startEvent id="sv_inicio" name="Conexión WebSocket aceptada">
      <bpmn:outgoing>Flujo_37</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_sv_inicio" />
    </bpmn:startEvent>
    <bpmn:receiveTask id="sv_cfg" name="Recibir el primer mensaje (texto JSON)">
      <bpmn:incoming>Flujo_37</bpmn:incoming>
      <bpmn:outgoing>Flujo_38</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="sv_gw_json" name="¿JSON válido?" default="Flujo_39">
      <bpmn:incoming>Flujo_38</bpmn:incoming>
      <bpmn:outgoing>Flujo_39</bpmn:outgoing>
      <bpmn:outgoing>Flujo_40</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="sv_err_cfg" name="Enviar error y cerrar (código 4000)">
      <bpmn:incoming>Flujo_40</bpmn:incoming>
      <bpmn:outgoing>Flujo_41</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="sv_fin_cfg" name="Mensaje inicial rechazado">
      <bpmn:incoming>Flujo_41</bpmn:incoming>
      <bpmn:errorEventDefinition id="Def_sv_fin_cfg" errorRef="Err_Config" />
    </bpmn:endEvent>
    <bpmn:task id="sv_flags" name="Leer opciones: analizar pose, solo captura y ejercicio forzado">
      <bpmn:incoming>Flujo_39</bpmn:incoming>
      <bpmn:outgoing>Flujo_42</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="sv_gw_bucle">
      <bpmn:incoming>Flujo_42</bpmn:incoming>
      <bpmn:incoming>Flujo_54</bpmn:incoming>
      <bpmn:outgoing>Flujo_43</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="sv_gw_evento">
      <bpmn:incoming>Flujo_43</bpmn:incoming>
      <bpmn:outgoing>Flujo_44</bpmn:outgoing>
      <bpmn:outgoing>Flujo_45</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="sv_jpeg" name="Fotograma JPEG recibido">
      <bpmn:incoming>Flujo_44</bpmn:incoming>
      <bpmn:outgoing>Flujo_46</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_sv_jpeg" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="sv_pose" name="Estimar la pose con MediaPipe (el motor se crea con el 1.er fotograma)">
      <bpmn:incoming>Flujo_46</bpmn:incoming>
      <bpmn:outgoing>Flujo_47</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="sv_gw_pose" name="¿Pose detectada?" default="Flujo_48">
      <bpmn:incoming>Flujo_47</bpmn:incoming>
      <bpmn:outgoing>Flujo_48</bpmn:outgoing>
      <bpmn:outgoing>Flujo_49</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="sv_sin_pose" name="Payload sin landmarks: knees = null, note «No se detectó ninguna pose»">
      <bpmn:incoming>Flujo_49</bpmn:incoming>
      <bpmn:outgoing>Flujo_52</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="sv_angulos" name="Calcular ángulos de rodilla sobre world_landmarks">
      <bpmn:incoming>Flujo_48</bpmn:incoming>
      <bpmn:outgoing>Flujo_50</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="sv_clasificar" name="Clasificar ejercicio y seguir repeticiones">
      <bpmn:incoming>Flujo_50</bpmn:incoming>
      <bpmn:outgoing>Flujo_51</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="sv_gw_merge">
      <bpmn:incoming>Flujo_51</bpmn:incoming>
      <bpmn:incoming>Flujo_52</bpmn:incoming>
      <bpmn:outgoing>Flujo_53</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="sv_enviar" name="Filtrar landmarks por visibilidad y enviar payload v1">
      <bpmn:incoming>Flujo_53</bpmn:incoming>
      <bpmn:outgoing>Flujo_54</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="sv_desconexion" name="Cliente cerró la conexión">
      <bpmn:incoming>Flujo_45</bpmn:incoming>
      <bpmn:outgoing>Flujo_55</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_sv_desconexion" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="sv_fin" name="Sesión de inferencia cerrada">
      <bpmn:incoming>Flujo_55</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flujo_37" sourceRef="sv_inicio" targetRef="sv_cfg" />
    <bpmn:sequenceFlow id="Flujo_38" sourceRef="sv_cfg" targetRef="sv_gw_json" />
    <bpmn:sequenceFlow id="Flujo_39" name="Sí" sourceRef="sv_gw_json" targetRef="sv_flags" />
    <bpmn:sequenceFlow id="Flujo_40" name="No" sourceRef="sv_gw_json" targetRef="sv_err_cfg">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">JSONDecodeError</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flujo_41" sourceRef="sv_err_cfg" targetRef="sv_fin_cfg" />
    <bpmn:sequenceFlow id="Flujo_42" sourceRef="sv_flags" targetRef="sv_gw_bucle" />
