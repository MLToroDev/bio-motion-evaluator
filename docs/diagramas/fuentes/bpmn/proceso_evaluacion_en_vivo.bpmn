    <bpmn:sequenceFlow id="Flujo_45" sourceRef="sv_gw_evento" targetRef="sv_desconexion" />
    <bpmn:sequenceFlow id="Flujo_46" sourceRef="sv_jpeg" targetRef="sv_pose" />
    <bpmn:sequenceFlow id="Flujo_47" sourceRef="sv_pose" targetRef="sv_gw_pose" />
    <bpmn:sequenceFlow id="Flujo_48" name="Sí" sourceRef="sv_gw_pose" targetRef="sv_angulos" />
    <bpmn:sequenceFlow id="Flujo_49" name="No" sourceRef="sv_gw_pose" targetRef="sv_sin_pose">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">pose_landmarks vacío</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flujo_50" sourceRef="sv_angulos" targetRef="sv_clasificar" />
    <bpmn:sequenceFlow id="Flujo_51" sourceRef="sv_clasificar" targetRef="sv_gw_merge" />
    <bpmn:sequenceFlow id="Flujo_52" sourceRef="sv_sin_pose" targetRef="sv_gw_merge" />
    <bpmn:sequenceFlow id="Flujo_53" sourceRef="sv_gw_merge" targetRef="sv_enviar" />
    <bpmn:sequenceFlow id="Flujo_54" sourceRef="sv_enviar" targetRef="sv_gw_bucle" />
    <bpmn:sequenceFlow id="Flujo_55" sourceRef="sv_desconexion" targetRef="sv_fin" />
    <bpmn:textAnnotation id="an_angulos"><bpmn:text>Fuente preferida: world_landmarks (metros, isótropo). flexión = 180° − ángulo interno (cadera, rodilla, tobillo).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Asoc_an_angulos" associationDirection="None" sourceRef="sv_angulos" targetRef="an_angulos" />
    <bpmn:textAnnotation id="an_clasif"><bpmn:text>Ventana de 45 fotogramas, clasificación con histéresis y bandera asymmetry_high si |L − R| / máx(L, R) &gt; 18 %.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Asoc_an_clasif" associationDirection="None" sourceRef="sv_clasificar" targetRef="an_clasif" />
  </bpmn:process>
