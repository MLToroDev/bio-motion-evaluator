# API
APP_NAME=bio-motion-evaluator-api
APP_VERSION=0.1.0
# Desarrollo: * permite cualquier origen (sin cookies cross-origin). Si usas lista concreta,
# el backend también acepta cualquier http(s)://localhost:PUERTO vía regex (Flutter web).
CORS_ORIGINS=*

# MediaPipe Pose Landmarker (.task). Por defecto full. Ej.: python scripts/download_models.py
# Para lite (más FPS): python scripts/download_models.py lite y MEDIAPIPE_POSE_MODEL_PATH=models/pose_landmarker_lite.task
MEDIAPIPE_POSE_MODEL_PATH=models/pose_landmarker_full.task
# Inferencia cada N frames (1 = todos; 2–3 reutiliza última pose OK en frames intermedios).
POSE_INFERENCE_STRIDE=1
# En JSON (WS + REST): solo enviar landmarks con visibility >= este valor (0 = los 33 puntos sin filtrar).
POSE_LANDMARK_MIN_VISIBILITY_RESPONSE=0.5

# Hugging Face (opcional): inferencia remota para clasificadores especializados
HF_API_TOKEN=
HF_INFERENCE_URL=

# Motor multi-ejercicio (opcional; ver ExerciseClassifierConfig en app/models/schemas.py)
CLASSIFIER_MIN_CONFIDENCE=0.72
CLASSIFIER_WINDOW_SIZE_FRAMES=45
CLASSIFIER_HYSTERESIS_FRAMES=10
CLASSIFIER_UNKNOWN_LABEL=unknown
CLASSIFIER_CONFIDENCE_EMA_ALPHA=0.25
# ema | kalman (suavizado de confianza antes de histéresis)
CLASSIFIER_CONFIDENCE_FILTER=ema
CLASSIFIER_KALMAN_PROCESS_NOISE=0.0001
CLASSIFIER_KALMAN_MEASUREMENT_NOISE=0.05
FEATURE_DEFAULT_DT_S=0.06666666666666667
FEATURE_CALIBRATION_MIN_FRAMES=10

# PostgreSQL async (asyncpg). Ej. postgresql://user:pass@localhost:5432/bio_motion
# Alembic usa la misma URL (reemplaza +asyncpg si la pegas desde async).
DATABASE_URL=

# JWT desarrollo (cambiar en producción)
JWT_SECRET=dev-insecure-change-me
STUB_USER_EMAIL=anonymous@local.test

# JSON: {"enable_onnx_classifier": true}
FEATURE_FLAGS_JSON={}

# ARCH-T14 — telemetría / backpressure (reservado para routers)
SERVER_PIPELINE_WARN_MS=300
ENABLE_ADAPTIVE_FRAME_DROP=false
