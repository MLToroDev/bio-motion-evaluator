# API
APP_NAME=bio-motion-evaluator-api
APP_VERSION=0.1.0
# Desarrollo: * permite cualquier origen (sin cookies cross-origin). Si usas lista concreta,
# el backend también acepta cualquier http(s)://localhost:PUERTO vía regex (Flutter web).
CORS_ORIGINS=*

# MediaPipe Pose Landmarker (.task). Ejecuta: python scripts/download_models.py
MEDIAPIPE_POSE_MODEL_PATH=models/pose_landmarker_full.task

# Hugging Face (opcional): inferencia remota para clasificadores especializados
HF_API_TOKEN=
HF_INFERENCE_URL=
