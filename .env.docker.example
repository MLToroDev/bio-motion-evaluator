# Variables opcionales para `docker compose` (copiar a `.env` en la raíz).
# Los valores por defecto del compose ya permiten arrancar sin este archivo.

POSTGRES_USER=biomotion
POSTGRES_PASSWORD=biomotion
POSTGRES_DB=bio_motion
POSTGRES_PORT=5432
REDIS_PORT=6379
# Si 8000 esta ocupado en el host (otro contenedor), usa 8001
BACKEND_PORT=8000
WEB_PORT=5173
WEB_DEMO_PORT=8080

# Orígenes CORS del navegador hacia el API (Vite 5173 / nginx demo 8080)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

JWT_SECRET=dev-insecure-change-me
# DEV_API_KEY=

# Aprendizaje continuo: guardar ventanas 32D en feature_samples durante inferencia
AUTO_COLLECT_ENABLED=false
AUTO_COLLECT_MIN_CONFIDENCE=0.85

# Validador / teacher (confirm|reject|changed) — Compose lo activa por defecto
# TEACHER=onnx usa vision/models/exercise_validator.onnx si existe; si no, cae a heuristic.
# Alternativa: auto | heuristic | margin
EXERCISE_VALIDATOR_ENABLED=true
EXERCISE_VALIDATOR_TEACHER=onnx
EXERCISE_VALIDATOR_GATE_COLLECT=true
# EXERCISE_VALIDATOR_ONNX_PATH=vision/models/exercise_validator.onnx
# EXERCISE_VALIDATOR_CLASSES=idle,squat,lunge

# Flags del build estático (perfil demo)
VITE_MVP_DEMO_MODE=true
VITE_MVP_SHOW_DEV=false
VITE_MVP_SHOW_SPRINT4=false
VITE_MVP_SHOW_3D=false
VITE_MVP_SHOW_ADV_VIDEO=false
VITE_MVP_SHOW_LIVE_EXERCISE=false
VITE_MVP_SHOW_REP_GOAL=false

# Detección de equipamiento (YOLO-World)
OBJECT_DETECT_ENABLED=true
OBJECT_DETECT_STRIDE=4
OBJECT_DETECT_CONF=0.28
# Directorio escribible para Ultralytics dentro del contenedor (Compose lo fija)
# YOLO_CONFIG_DIR=/tmp/Ultralytics
